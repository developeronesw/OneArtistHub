HOST=127.0.0.1
PORT=8788
# mysql | mariadb | sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oneartist_hub
DB_USER=oneartist_hub
DB_PASSWORD=CHANGE_ME
# Used only when DB_DRIVER=sqlite
SQLITE_FILE=/var/lib/oneartist-hub/oneartist.sqlite
ONEARTIST_SETUP_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
MEDIA_ROOT=/var/lib/oneartist-hub/media
MAX_UPLOAD_BYTES=536870912
# Optional central PayPal partner-connect service
ONEARTIST_CONNECT_URL=
# Self-hosted deployments are not automatically provisioned. Use managed enrollment or a legacy token.
# Legacy manually-provisioned credential. New installations leave this empty.
ONEARTIST_CONNECT_TOKEN=
