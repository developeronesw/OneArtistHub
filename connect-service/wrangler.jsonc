{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneartisthub-connect",
  "main": "paypal-worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "kv_namespaces": [
    {
      "binding": "CONNECT_INSTALLATIONS",
      "id": "3a775fdfa9f646d4a4a0da9d1727286c"
    }
  ],
  "triggers": { "crons": ["0 */6 * * *"] },
  "routes": [
    {
      "pattern": "connect.oneartisthub.site",
      "custom_domain": true
    }
  ]
}
